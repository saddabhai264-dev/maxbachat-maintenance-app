{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "functions": {
    "api/index.js": {
      "includeFiles": "{backend/schema.sql,frontend/**}",
      "maxDuration": 60
    }
  },
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/health/db", "destination": "/api/index.js" }
  ]
}
